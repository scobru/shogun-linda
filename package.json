{
  "name": "linda-pear",
  "productName": "linda",
  "version": "1.14.56",
  "private": true,
  "type": "module",
  "workspaces": [
    "mobile"
  ],
  "overrides": {
    "react-native-bare-kit": "0.14.5",
    "react-native": "0.79.6"
  },
  "main": "pear.js",
  "pear": {
    "name": "linda-pear",
    "type": "desktop",
    "gui": {
      "main": "pear.html",
      "backgroundColor": "#0b0f14",
      "width": 960,
      "height": 680,
      "minWidth": 640,
      "minHeight": 480
    },
    "pre": "pear-electron/pre"
  },
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "node test.js",
    "clean-storage": "node -e \"const fs=require('fs');fs.rmSync('./.dev-storage',{recursive:true,force:true});console.log('Storage cleaned.');\"",
    "start": "node build.js && electron ./electron/main.cjs",
    "start:a": "node build.js && cross-env LINDA_PEAR_STORAGE_DIR=./.dev-storage/a electron ./electron/main.cjs",
    "start:b": "node build.js && cross-env LINDA_PEAR_STORAGE_DIR=./.dev-storage/b electron ./electron/main.cjs",
    "start:pear": "node build.js && pear run --dev .",
    "make": "node build.js && electron-forge make",
    "pear:stage": "pear stage pear://fe1g7q7wqqjundb7t3pdz93tz7n9cm7sakr46mdg6ipg4tk15xno . --ignore mobile,.dev-storage,.claude,.git,out,test,release-artifacts,.cache,electron-smoke.mjs,electron,index.html,dist/app.js,dist/app.js.map,forge.config.cjs,.headroom,.serena,node_modules/.bin,node_modules/electron,node_modules/@electron,node_modules/@electron-forge,node_modules/esbuild,node_modules/@esbuild,node_modules/typescript,node_modules/@types --purge",
    "pear:seed": "pear seed pear://fe1g7q7wqqjundb7t3pdz93tz7n9cm7sakr46mdg6ipg4tk15xno"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "P2P messaging and file sharing app on the Holepunch stack",
  "dependencies": {
    "@hyperswarm/secret-stream": "^6.9.1",
    "@react-native/js-polyfills": "^0.79.6",
    "autobase": "^7.28.1",
    "b4a": "^1.8.1",
    "bare-events": "^2.9.1",
    "bare-fs": "^4.7.4",
    "bare-http1": "^4.5.8",
    "bare-os": "^3.9.3",
    "bare-path": "^3.1.1",
    "bare-rpc": "^1.3.8",
    "bare-tcp": "^2.6.1",
    "bip39": "^3.1.0",
    "compact-encoding": "^3.3.0",
    "corestore": "^7.12.0",
    "hyperbee": "^2.27.3",
    "hypercore": "^11.35.1",
    "hypercore-crypto": "^3.7.0",
    "hyperdrive": "^13.3.3",
    "hyperswarm": "^4.17.0",
    "jsqr": "^1.4.0",
    "multicast-dns": "^7.2.5",
    "pear-bridge": "^1.2.0",
    "pear-crasher": "^1.0.1",
    "pear-electron": "^1.7.28",
    "pear-pipe": "^1.0.6",
    "pear-run": "^2.0.0",
    "pear-updates": "^1.1.0",
    "pear-user-dirs": "^1.0.3",
    "pear-wakeups": "^1.0.0",
    "protomux": "^3.11.0",
    "qrcode": "^1.5.4",
    "sodium-javascript": "^0.8.0",
    "sodium-universal": "^5.0.1",
    "streamx": "^2.28.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-msix": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "babel-plugin-module-resolver": "^5.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "upgrade": "pear://fe1g7q7wqqjundb7t3pdz93tz7n9cm7sakr46mdg6ipg4tk15xno"
}
